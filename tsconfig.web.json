{
  "extends": "../vaultite/tsconfig.app.json",
  "compilerOptions": {
    "incremental": false,
    "tsBuildInfoFile": null,
    "paths": {
      "@/*": [
        "../vaultite/web/src/*"
      ],
      "@vaultite": [
        "../vaultite/web/src/api.ts"
      ],
      "@plugins/*": [
        "./*",
        "../vaultite/plugins/core/*"
      ]
    }
  },
  "include": [
    "*/index.tsx",
    "*/*.d.ts",
    "../vaultite/web/src/**/*.d.ts"
  ]
}

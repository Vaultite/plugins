{
  "extends": "../vaultite/tsconfig.server.json",
  "compilerOptions": {
    "incremental": false,
    "tsBuildInfoFile": null,
    "paths": {
      "@vaultite/core/*": [
        "../vaultite/core/*"
      ],
      "@plugins/*": [
        "./*.ts",
        "../vaultite/plugins/core/*.ts",
        "../vaultite/plugins/core/*/index.ts"
      ]
    }
  },
  "include": [
    "*/plugin.ts",
    "*/import.ts",
    "*/cli.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
